
# Water-only simulation at 300 K and 100 bar

units            real
atom_style       full
dimension        3
boundary         p p p
newton           off

read_data        water.data

pair_style       lj/cut/coul/long 7.0 9.0
#pair_modify      mix sixthpower
kspace_style     pppm 1.0e-4
kspace_modify    diff ad

bond_style       harmonic
angle_style      harmonic
#dihedral_style   charmm
#improper_style   harmonic
#special_bonds    charmm

dielectric       1.0
neighbor         4.0 bin
neigh_modify     delay 0 every 1 check yes

mass             1 15.9994
mass             2 1.00800

pair_coeff       1 1 0.1521 3.1507
pair_coeff       2 2 0.0 1.0
bond_coeff       1 450.0 0.9572
angle_coeff      1 55.0 104.52

timestep         1.0
thermo           1000
thermo_style     custom step temp press density pe ke etotal vol

min_style        cg
minimize         1.0e-6 1.0e-8 1000 10000

velocity         all create 300.0 4928459 mom yes rot yes dist gaussian

fix              equil all npt temp 300.0 300.0 100.0 iso 98.6923 98.6923 1000.0

run              50000

unfix            equil
write_data       /hickory/users/r/g/rghanta/water_data/tip3p_orig/100bar/water_100bar_equilibrated.data
write_restart    /hickory/users/r/g/rghanta/water_data/tip3p_orig/100bar/water_100bar.restart

