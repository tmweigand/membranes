
# Continue water equilibration at 300 K and 100 bar

units            real
atom_style       full
dimension        3
boundary         p p p
newton           off

read_restart     /hickory/users/r/g/rghanta/water_data/tip3p_orig/100bar/water_100bar.restart

pair_style       lj/cut/coul/long 7.0 9.0
#pair_modify      mix sixthpower
kspace_style     pppm 1.0e-4
kspace_modify    diff ad

bond_style       harmonic
angle_style      harmonic
#dihedral_style   charmm
#improper_style   harmonic
#special_bonds    charmm

dielectric       1.0
neighbor         4.0 bin
neigh_modify     delay 0 every 1 check yes

mass             1 15.9994
mass             2 1.00800

pair_coeff       1 1 0.1521 3.1507
pair_coeff       2 2 0.0 1.0
bond_coeff       1 450.0 0.9572
angle_coeff      1 55.0 104.52

timestep         1.0

thermo           1000
thermo_style     custom step temp press density pe ke etotal vol

# Record thermodynamic history separately
variable         T equal temp
variable         P equal press
variable         Rho equal density
variable         V equal vol

fix              hist all ave/time 100 10 1000 v_T v_P v_Rho v_V file /hickory/users/r/g/rghanta/water_data/tip3p_orig/100bar/thermo_100bar_continue.dat

# Continue NPT equilibration
fix              equil all npt temp 300.0 300.0 100.0 iso 98.6923 98.6923 1000.0

run              200000

unfix            equil
unfix            hist

write_data       /hickory/users/r/g/rghanta/water_data/tip3p_orig/100bar/water_100bar_extended.data
write_restart    /hickory/users/r/g/rghanta/water_data/tip3p_orig/100bar/water_100bar_extended.restart

