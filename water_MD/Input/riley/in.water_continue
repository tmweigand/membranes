
# Continue water equilibration at 300 K and 1 bar

units            real
atom_style       full
dimension        3
boundary         p p p
newton           off

read_restart     /hickory/users/r/g/rghanta/water_data/riley/1bar/water_1bar.restart

pair_style       lj/charmm/coul/long 7.0 9.0
pair_modify      mix sixthpower
kspace_style     pppm 1.0e-4
kspace_modify    diff ad

bond_style       harmonic
angle_style      harmonic
dihedral_style   charmm
improper_style   harmonic
special_bonds    charmm

dielectric       1.0
neighbor         4.0 bin
neigh_modify     delay 0 every 1 check yes

# Force-field parameters from the existing simulation
mass             1 16.000000
mass             2 1.008000

pair_coeff       1 1 0.155865 3.178
pair_coeff       2 2 0.0 0.0
bond_coeff       1 450.0 1.0118
angle_coeff      1 55.0 108.15

timestep         1.0

thermo           1000
thermo_style     custom step temp press density pe ke etotal vol

# Record thermodynamic history separately
variable         T equal temp
variable         P equal press
variable         Rho equal density
variable         V equal vol

fix              hist all ave/time 100 10 1000 v_T v_P v_Rho v_V file /hickory/users/r/g/rghanta/water_data/riley/1bar/thermo_1bar_continue.dat

# Continue NPT equilibration
fix              equil all npt temp 300.0 300.0 100.0 iso 0.986923 0.986923 1000.0

run              200000

unfix            equil
unfix            hist

write_data       /hickory/users/r/g/rghanta/water_data/riley/1bar/water_1bar_extended.data
write_restart    /hickory/users/r/g/rghanta/water_data/riley/1bar/water_1bar_extended.restart
